/** Devolve a base como matriz pronta para a aba BASE_LC214. */
function matrizBaseLC214() {
  var cab = ['NCM', 'Item', 'Anexo', 'Hipotese tributaria', 'Beneficio',
             'Exige Anvisa (S/N)', 'cClassTrib', 'Texto literal do anexo'];
  var saida = [cab];
  var linhas = DADOS_LC214.split('\n');
  for (var i = 0; i < linhas.length; i++) {
    if (!linhas[i]) continue;
    var p = linhas[i].split('|');
    var r = REGRA_ANEXO[p[2]] || ['Anexo ' + p[2], '', 'N', ''];
    saida.push([p[0], p[1], 'Anexo ' + p[2], r[0], r[1], r[2], r[3], p.slice(3).join('|')]);
  }
  return saida;
}